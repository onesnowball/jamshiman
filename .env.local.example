# Supabase — get from your Supabase project dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
ALLOWED_SCHOOL_DOMAINS=umich.edu
NEXT_PUBLIC_ALLOWED_SCHOOL_DOMAINS=umich.edu

# Admin — comma-separated list of admin emails, auto-promoted on login
ADMIN_EMAILS=your@umich.edu

# Dev bypass — local development only
NEXT_PUBLIC_DEV_BYPASS_AUTH=false
DEV_BYPASS_EMAIL=your@umich.edu
DEV_BYPASS_PASSWORD=change-this-local-only
